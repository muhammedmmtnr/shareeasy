# Optional public MapLibre-compatible style URL. Defaults to OpenFreeMap Liberty.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Supported geocoding provider: photon (no API key; public service limits apply).
VITE_GEOCODING_PROVIDER=photon

# Supported routing provider: osrm. The default URL is the public OSRM demo server.
VITE_ROUTING_PROVIDER=osrm

# Optional server-side OSRM-compatible service URL; do not expose credentials here.
# OSRM_API_URL=https://your-private-osrm.example.com
